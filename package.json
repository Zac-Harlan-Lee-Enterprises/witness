{
  "name": "witness-game",
  "private": true,
  "version": "0.1.0",
  "description": "Witness: A Journey Through Scripture — a local-first Christian narrative adventure (vertical slice: The Road to Jericho).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run content:validate && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:arch": "vitest run --project unit tests/architecture",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:publish-check": "tsx scripts/validate-content.ts --publish-check",
    "icons": "node scripts/generate-icons.mjs",
    "art:data": "tsx scripts/export-art-data.ts",
    "art:market": "node scripts/art-build.mjs market",
    "art:people": "node scripts/art-build.mjs people",
    "art:portrait-data": "tsx scripts/export-portrait-data.ts",
    "art:portraits": "node scripts/art-build.mjs portraits",
    "art:portrait-sheets": "node scripts/portrait-sheets.mjs",
    "deadcode": "knip",
    "perf:bundle": "node scripts/report-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "idb": "^8.0.3",
    "phaser": "3.90.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
