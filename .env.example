# Copy to .env.local for local overrides. This app has NO secrets:
# everything here is public build-time configuration baked into the bundle.
# Never put credentials in a VITE_* variable — Vite ships them to the browser.

# Deploy under a sub-path (e.g. GitHub Pages project site). Default "/".
VITE_BASE_PATH=/

# Configurable working title (see src/app/config.ts).
VITE_GAME_TITLE=Witness: A Journey Through Scripture
VITE_GAME_SHORT_TITLE=Witness

# Content publication mode:
#   preview (default) — unreviewed educational content is shown with a visible
#                       "Awaiting editorial review" label.
#   strict            — `npm run build` FAILS unless every educational record has
#                       been approved by a named human (same check as
#                       `npm run content:publish-check`). See docs/content-governance.md.
VITE_CONTENT_MODE=preview
